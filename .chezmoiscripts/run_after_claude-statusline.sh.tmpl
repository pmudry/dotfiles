#!/bin/sh
# Register the Claude Code status line (model · directory · git branch) in
# ~/.claude/settings.json. That file also holds per-machine state (permissions,
# model choice, plugins), so it is not managed as a whole — this merges in the
# single `statusLine` key and leaves everything else untouched.

SETTINGS="{{ .chezmoi.homeDir }}/.claude/settings.json"
SCRIPT="{{ .chezmoi.homeDir }}/.claude/statusline.sh"

[ -x "$SCRIPT" ] || exit 0
command -v python3 >/dev/null 2>&1 || exit 0

python3 - "$SETTINGS" "$SCRIPT" <<'PY'
import json, os, sys

path, script = sys.argv[1], sys.argv[2]
os.makedirs(os.path.dirname(path), exist_ok=True)

try:
    with open(path) as f:
        settings = json.load(f)
except (OSError, ValueError):
    settings = {}

wanted = {"type": "command", "command": script, "padding": 0}
if settings.get("statusLine") == wanted:
    sys.exit(0)

settings["statusLine"] = wanted
tmp = path + ".tmp"
with open(tmp, "w") as f:
    json.dump(settings, f, indent=2, ensure_ascii=False)
    f.write("\n")
os.replace(tmp, path)
print("claude: statusLine registered in", path)
PY
