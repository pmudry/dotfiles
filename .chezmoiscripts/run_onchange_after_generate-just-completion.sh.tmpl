#!/bin/sh
# Generate the zsh completion for `just` into ~/.zsh/completions/_just.
#
# run_onchange_ re-runs this script only when its rendered content changes.
# When `just` is installed, the version is embedded below, so a `just` upgrade
# changes the content and retriggers generation. When it isn't installed, this
# is a harmless no-op (and starts generating once just appears on PATH).
#
# ~/.zsh/completions is added to $fpath in dot_zshrc, before antigen/oh-my-zsh
# runs compinit, so the file is picked up automatically.
{{ if lookPath "just" -}}
# just version: {{ output "just" "--version" | trim }}
mkdir -p "$HOME/.zsh/completions"
just --completions zsh > "$HOME/.zsh/completions/_just"
echo "Generated ~/.zsh/completions/_just ({{ output "just" "--version" | trim }})"
{{ else -}}
echo "just not found on PATH; skipping _just completion generation"
{{ end -}}
