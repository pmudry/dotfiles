# Silence zoxide's "initialize at the end of your config" doctor warning.
# It fires when `z` (our `cd` alias) runs before zoxide's chpwd hook is
# registered. Some harnesses (e.g. an agent shell) inject a `cd` into the
# cwd on every fresh shell before this rc finishes sourcing, so it warns
# on every command. The init below is deliberate and works; the check is a
# false positive here. Set before anything can call `cd`/`z`.
export _ZO_DOCTOR=0

# Put ~/.local/bin on PATH up front: the fastfetch banner below lives there, and
# a fresh login shell (Windows Terminal → WSL) doesn't have it on PATH yet.
export PATH="$HOME/.local/bin:$PATH"

# fastfetch banner. Guarded so a machine without it doesn't trip the
# command-not-found handler ("fastfetch is not installed") on every launch.
command -v fastfetch >/dev/null && fastfetch --logo-type file --logo ~/.config/fastfetch/isc-logo.ans -c ~/.config/fastfetch/examples/22.jsonc

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi


# Keep 10,000,000 lines of history within the shell and save it to ~/.zsh_history:
HISTSIZE=10000000
SAVEHIST=10000000
HISTFILE=~/.zsh_history

# Platform specific customizations
#source ~/.platformrc

ZSH_AUTOSUGGEST_STRATEGY=(history completion)

source ~/antigen.zsh
antigen init ~/.antigenrc
antigen use oh-my-zsh
antigen bundle git
antigen bundle command-not-found

# antigen finishes with `compdef` left as an empty stub, which silently drops
# every compdef-based completion (zoxide's `z`, just's clap completer, …).
# Re-run compinit (cached → fast) to restore the real compdef before using it.
autoload -Uz compinit && compinit -C

# just (https://github.com/casey/just) shell completion — clap's dynamic completer,
# regenerated live on each shell start so it never goes stale. The script this
# version of just emits ends with a bare `_just "$@"`, which fires the completer
# outside a completion context ("_arguments: can only be called from completion
# function") and never registers anything. Drop that trailing call and wire the
# function up with compdef ourselves; the sed is a no-op on newer just releases,
# whose footer already guards the call with a $funcstack check.
if command -v just >/dev/null; then
  source <(just --completions zsh | sed '/^_just "\$@"$/d')
  compdef _just just
fi

# Aliases
#alias rcat="$(which cat)"
#alias cat="$(which bat)"
alias cd="z"

# export DISPLAY=$localhost:10.0  # WSL X-forwarding to an external X server on :10.
# Disabled: under WSLg, DISPLAY is auto-set to :0; forcing :10.0 breaks GUI apps.
# Re-enable only if you run VcXsrv/X410 on display :10.

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
eval "$(zoxide init zsh)"

# ──────────────────────────────────────────────────────────────────────────
# Per-machine toolchains (merged from this box's pre-chezmoi ~/.zshrc).
# All guarded, so each is a no-op on machines where the tool isn't installed.
# ──────────────────────────────────────────────────────────────────────────
export ISC_TOOLCHAIN="$HOME/git/isc_templates/build_tool/"

# uv / pip env (writes ~/.local/bin/env)
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"  # completions

# opencode
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# CUDA toolkit
[ -d /usr/local/cuda-13/bin ] && export PATH="$PATH:/usr/local/cuda-13/bin"

# nvm — sourcing nvm.sh eagerly runs `nvm use` for the default alias on *every*
# shell (~0.9s, ~65% of startup). Instead: put the default node on PATH directly
# (cheap, and visible to child processes too), and load nvm's machinery lazily on
# the first `nvm` call.
export NVM_DIR="$HOME/.nvm"
if [[ -d "$NVM_DIR/versions/node" ]]; then
  # newest installed version = what the `default -> node` alias resolves to
  _nvm_default="$(command ls -1v "$NVM_DIR/versions/node" 2>/dev/null | tail -1)"
  [[ -n "$_nvm_default" ]] && export PATH="$NVM_DIR/versions/node/$_nvm_default/bin:$PATH"
  unset _nvm_default
fi
nvm() {
  unset -f nvm
  [[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh" --no-use
  [[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
  nvm "$@"
}

# SDKMAN — must stay at the very end of the file
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"

