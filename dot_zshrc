# Silence zoxide's "initialize at the end of your config" doctor warning.
# It fires when `z` (our `cd` alias) runs before zoxide's chpwd hook is
# registered. Some harnesses (e.g. an agent shell) inject a `cd` into the
# cwd on every fresh shell before this rc finishes sourcing, so it warns
# on every command. The init below is deliberate and works; the check is a
# false positive here. Set before anything can call `cd`/`z`.
export _ZO_DOCTOR=0

# Put ~/.local/bin on PATH up front: the fastfetch banner below lives there, and
# a fresh login shell (Windows Terminal → WSL) doesn't have it on PATH yet.
export PATH="$HOME/.local/bin:$PATH"

# fastfetch banner. Guarded so a machine without it doesn't trip the
# command-not-found handler ("fastfetch is not installed") on every launch.
#
# --ds-force-drm: the `display` module's default backend is Wayland. Under WSLg
# the compositor socket (/mnt/wslg/runtime-dir/wayland-0) accepts the connection
# but never answers the roundtrip, so fastfetch blocks in poll() forever and the
# terminal hangs with the logo half-drawn. Forcing the DRM backend skips Wayland
# entirely; WSL exposes no DRM device, so the module simply prints nothing.
#
# The logo is a chafa render of the ISC petals symbol, baked to a file rather
# than rendered live: fastfetch's own image logo types (chafa/sixel/kitty) first
# ask the terminal for its cell pixel size (CSI 14t). This one never answers, so
# `--chafa <image>` hangs the shell instead of falling back — tested, needs a
# Ctrl-C. A pre-rendered .ans queries nothing. Regenerate with:
#   chafa -f symbols -s 36x18 --polite on \
#     "$HOME/git/isc/isc-logos/symbol only/ISC_logo_rvb.svg" > ~/.config/fastfetch/isc-logo.ans
command -v fastfetch >/dev/null && fastfetch --ds-force-drm true --logo-type file-raw --logo ~/.config/fastfetch/isc-logo.ans -c ~/.config/fastfetch/examples/22.jsonc

# Enable Powerlevel10k instant prompt. Should stay close to the top of ~/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi


# Keep 10,000,000 lines of history within the shell and save it to ~/.zsh_history:
HISTSIZE=10000000
SAVEHIST=10000000
HISTFILE=~/.zsh_history

# Platform specific customizations
#source ~/.platformrc

ZSH_AUTOSUGGEST_STRATEGY=(history completion)

source ~/antigen.zsh
antigen init ~/.antigenrc
antigen use oh-my-zsh
antigen bundle git
antigen bundle command-not-found

# antigen finishes with `compdef` left as an empty stub, which silently drops
# every compdef-based completion (zoxide's `z`, just's clap completer, …).
# Re-run compinit (cached → fast) to restore the real compdef before using it.
autoload -Uz compinit && compinit -C

# just (https://github.com/casey/just) shell completion — clap's dynamic
# completer, regenerated live on each shell start so it never goes stale.
# What `just --completions zsh` prints is a `#compdef just` autoload stub, not
# something meant to be sourced: older releases end it with a bare `_just "$@"`
# that fires outside a completion context ("_arguments: can only be called from
# completion function"), and newer ones guard that call behind a $funcstack
# check, so sourcing defines the real completer but registers nothing. Strip the
# bare call (a no-op on newer just), then bind the name the stub expects to the
# completer it defined and register that ourselves.
if command -v just >/dev/null; then
  source <(just --completions zsh | sed '/^_just "\$@"$/d')
  if (( ! $+functions[_just] )) && (( $+functions[_clap_dynamic_completer_just] )); then
    functions[_just]=$functions[_clap_dynamic_completer_just]
  fi
  (( $+functions[_just] )) && compdef _just just
fi

# Aliases
#alias rcat="$(which cat)"
#alias cat="$(which bat)"
alias cd="z"

# lsd replaces ls (icons need a Nerd Font in the terminal profile).
alias ls="lsd"
alias ll="lsd -l"
alias la="lsd -lA"
alias l="lsd -lA"
alias lt="lsd --tree"

# export DISPLAY=$localhost:10.0  # WSL X-forwarding to an external X server on :10.
# Disabled: under WSLg, DISPLAY is auto-set to :0; forcing :10.0 breaks GUI apps.
# Re-enable only if you run VcXsrv/X410 on display :10.

# To customize prompt, run `p10k configure` or edit ~/.p10k.zsh.
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh
eval "$(zoxide init zsh)"

# fzf shell integration: Ctrl-R fuzzy history, Ctrl-T file picker, Alt-C cd,
# and `**<Tab>` completion. Needs the real compdef (restored at compinit above).
# The `--zsh` flag only exists from fzf 0.48; Debian/Ubuntu still ship 0.44,
# which installs the very same snippets under /usr/share/doc/fzf/examples
# instead. Try the flag, fall back to the packaged files, no-op without fzf.
if command -v fzf >/dev/null; then
  if fzf --zsh >/dev/null 2>&1; then
    source <(fzf --zsh)
  else
    for _fzf_snippet in /usr/share/doc/fzf/examples/{key-bindings,completion}.zsh; do
      [ -r "$_fzf_snippet" ] && source "$_fzf_snippet"
    done
    unset _fzf_snippet
  fi
fi

# ──────────────────────────────────────────────────────────────────────────
# Per-machine toolchains (merged from this box's pre-chezmoi ~/.zshrc).
# All guarded, so each is a no-op on machines where the tool isn't installed.
# ──────────────────────────────────────────────────────────────────────────
export ISC_TOOLCHAIN="$HOME/git/isc_templates/build_tool/"

# uv / pip env (writes ~/.local/bin/env)
[ -f "$HOME/.local/bin/env" ] && . "$HOME/.local/bin/env"

# bun
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$BUN_INSTALL/_bun" ] && source "$BUN_INSTALL/_bun"  # completions

# opencode
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# CUDA toolkit
[ -d /usr/local/cuda-13/bin ] && export PATH="$PATH:/usr/local/cuda-13/bin"

# GitHub token for the Claude Code github plugin's MCP server. Its .mcp.json
# sends `Authorization: Bearer ${GITHUB_PERSONAL_ACCESS_TOKEN}`, so with the
# variable unset the header reaches api.githubcopilot.com unsubstituted and the
# server refuses to connect with "400 — Authorization header is badly
# formatted". Read from gh rather than stored: no token on disk, and rotations
# follow on their own. MCP servers inherit this from the Claude Code process,
# so a running session needs a restart to pick it up.
if command -v gh >/dev/null 2>&1; then
    _gh_token="$(gh auth token 2>/dev/null)"
    [ -n "$_gh_token" ] && export GITHUB_PERSONAL_ACCESS_TOKEN="$_gh_token"
    unset _gh_token
fi

# nvm — sourcing nvm.sh eagerly runs `nvm use` for the default alias on *every*
# shell (~0.9s, ~65% of startup). Instead: put the default node on PATH directly
# (cheap, and visible to child processes too), and load nvm's machinery lazily on
# the first `nvm` call.
export NVM_DIR="$HOME/.nvm"
if [[ -d "$NVM_DIR/versions/node" ]]; then
  # newest installed version = what the `default -> node` alias resolves to
  _nvm_default="$(command ls -1v "$NVM_DIR/versions/node" 2>/dev/null | tail -1)"
  [[ -n "$_nvm_default" ]] && export PATH="$NVM_DIR/versions/node/$_nvm_default/bin:$PATH"
  unset _nvm_default
fi
nvm() {
  unset -f nvm
  [[ -s "$NVM_DIR/nvm.sh" ]] && source "$NVM_DIR/nvm.sh" --no-use
  [[ -s "$NVM_DIR/bash_completion" ]] && source "$NVM_DIR/bash_completion"
  nvm "$@"
}

# SDKMAN — must stay at the very end of the file
export SDKMAN_DIR="$HOME/.sdkman"
[[ -s "$HOME/.sdkman/bin/sdkman-init.sh" ]] && source "$HOME/.sdkman/bin/sdkman-init.sh"


# ssh-agent: one agent shared by every session on a fixed socket, so keys get
# loaded once (`ssh-add ~/.ssh/key_2024-id_ed25519`) and stay reachable from any
# shell — including the ones tooling spawns for itself.
#
# Boxes running the systemd user unit ~/.config/systemd/user/ssh-agent.service
# already have an agent on $XDG_RUNTIME_DIR/ssh-agent.socket; prefer it, since
# systemd owns its lifecycle and there is no start-up race. Everywhere else,
# fall back to self-spawning one on ~/.ssh/agent.sock.
# macOS already runs a launchd ssh-agent (with Keychain integration) and sets
# SSH_AUTH_SOCK for every session, so leave it alone there.
if [[ "$OSTYPE" == darwin* ]]; then
    :
elif [ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent.socket" ]; then
    export SSH_AUTH_SOCK="${XDG_RUNTIME_DIR:-/run/user/$UID}/ssh-agent.socket"
else
    export SSH_AUTH_SOCK="$HOME/.ssh/agent.sock"
    ssh-add -l >/dev/null 2>&1
    if [ $? -eq 2 ]; then  # 2 = no agent listening on the socket
        rm -f "$SSH_AUTH_SOCK"
        eval "$(ssh-agent -a "$SSH_AUTH_SOCK")" >/dev/null
    fi
fi
